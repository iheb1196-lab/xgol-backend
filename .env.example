DB=mongodb://127.0.0.1:27017/xgol
PORT=8080
SALT=10
JWTPRIVATEKEY=replace-with-a-long-random-secret
FRONT_URL=http://localhost:3000

# Region used to build default Bedrock Mantle endpoint URLs.
AWS_REGION=us-east-1

# Select which Bedrock Mantle API generates feedback.
BEDROCK_MANTLE_API=openai

# These are Amazon Bedrock API keys, not keys from anthropic.com or openai.com.
ANTHROPIC_MANTLE_API_KEY=replace-with-an-amazon-bedrock-api-key
ANTHROPIC_MANTLE_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/anthropic
ANTHROPIC_MANTLE_WORKSPACE_ID=proj_replace-me
ANTHROPIC_MANTLE_MODEL_ID=anthropic.claude-sonnet-5

OPENAI_MANTLE_API_KEY=replace-with-an-amazon-bedrock-api-key
OPENAI_MANTLE_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/openai/v1
OPENAI_MANTLE_PROJECT_ID=proj_replace-me
OPENAI_MANTLE_MODEL_ID=google.gemma-4-e2b

RESEND_API_KEY=replace-with-a-resend-api-key
RESEND_FROM=XGOL <noreply@example.com>

# Optional credentials created by `npm run seed:local`.
LOCAL_DEMO_EMAIL=demo@xgol.local
LOCAL_DEMO_PASSWORD=XgolLocal123!
